# Copy to .env and edit. Every setting is optional unless marked required.

# development | test | production   (production refuses to start with a weak ADMIN_TOKEN)
ENV=development

# --- Clinic
CLINIC_NAME=Sunrise Multi-Speciality Clinic
CLINIC_PHONE=+91 90000 00000
CLINIC_TIMEZONE=Asia/Kolkata
BOOKING_LEAD_MINUTES=15
BOOKING_HORIZON_DAYS=30

# --- Security
# required in production
ADMIN_TOKEN=change-me
# set to verify WhatsApp webhook signatures
TWILIO_AUTH_TOKEN=
# e.g. https://clinic.onrender.com (needed behind a proxy)
PUBLIC_BASE_URL=
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- Automatic WhatsApp reminders (Twilio). All three are needed to send.
TWILIO_ACCOUNT_SID=
# e.g. +14155238886 for the Twilio sandbox
TWILIO_WHATSAPP_FROM=
# Hour of the day (0-23, clinic time) to send tomorrow's reminders automatically. Empty = off.
REMINDER_SEND_HOUR=

# --- Storage
# SQLite file (default). Ignored when DATABASE_URL is set.
DB_PATH=clinic.db
# Postgres for hosting, e.g. a free Neon database: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
SEED_DEMO_DATA=true

# --- Observability
LOG_LEVEL=INFO
LOG_JSON=false

# --- Optional LLM (any OpenAI-compatible API; Groq has a free tier)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=2
